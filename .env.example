# Copy to .env (gitignored). Never commit a real key.
OPENROUTER_API_KEY=
# Model ids come from GET https://openrouter.ai/api/v1/models
MODEL_CHAT=
# Wave 2 optimize loop and interviews. Tested Nov 7: anthropic/claude-haiku-5.5 (reasoning off), about $0.0005 per round.
# Empty = rules propose the optimize edits and interviews use a plain template. No call falls back to MODEL_CHAT.
MODEL_FAST=
# Lane B dish photos. Tested Nov 7: google/gemini-3.1-flash-lite-image, 3 s and $0.034 per photo.
MODEL_IMAGE=
# Lane B logo only, falls back to MODEL_IMAGE. Tested: google/gemini-3.1-flash-image, 9 s and $0.067.
MODEL_IMAGE_LOGO=
# 1 = every endpoint serves its fixture from data/fixtures/
MOCK=0
# Change both in a lane worktree so lanes can run side by side.
PORT=8787
WEB_PORT=5173
