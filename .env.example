# Copy to .env (gitignored). Never commit a real key.
OPENROUTER_API_KEY=
# Model ids come from GET https://openrouter.ai/api/v1/models
MODEL_CHAT=
MODEL_FAST=
# Lane B image model. Candidates with image output (Nov 7): google/gemini-3.1-flash-image, google/gemini-3-pro-image
MODEL_IMAGE=
# Optional: a different model for the logo only. Falls back to MODEL_IMAGE.
# MODEL_IMAGE_LOGO=
# 1 = every endpoint serves its fixture from data/fixtures/
MOCK=0
# Change both in a lane worktree so lanes can run side by side.
PORT=8787
WEB_PORT=5173
